{
  "name": "@strategos/shell-electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "description": "Strategos desktop shell: window, tray, badge, toasts, hotkey",
  "scripts": {
