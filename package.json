{
  "name": "strategos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run test && npm run lint",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tools/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "strategos": "node packages/daemon/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "preact": "^10.29.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
